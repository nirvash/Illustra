<UserControl x:Class="Illustra.Views.Settings.McpSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
    <StackPanel>
        <GroupBox Header="{DynamicResource String_Settings_Mcp_Section}">
            <StackPanel Margin="5" Grid.IsSharedSizeScope="True">

                <!-- 有効/無効（即時反映） -->
                <CheckBox Content="{DynamicResource String_Settings_Mcp_EnableServer}"
                          IsChecked="{Binding EnableServer}"
                          VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}"
                           Margin="20,2,0,0"
                           Foreground="Gray"/>

                <!-- ポート番号（適用で反映） -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="McpLabel"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource String_Settings_Mcp_Port}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                             Width="80"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            Content="{DynamicResource String_Settings_Mcp_Apply}"
                            Command="{Binding ApplyPortCommand}"
                            Margin="10,0,0,0"
                            Padding="10,3"/>
                </Grid>

                <!-- Bearer 認証（即時反映） -->
                <CheckBox Content="{DynamicResource String_Settings_Mcp_RequireAuth}"
                          IsChecked="{Binding RequireAuth}"
                          Margin="0,5,0,0"
                          VerticalAlignment="Center"/>

                <!-- アクセストークン -->
                <Grid Margin="0,10,0,0" IsEnabled="{Binding RequireAuth}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="McpLabel"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource String_Settings_Mcp_Token}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding TokenDisplay, Mode=OneWay}"
                             IsReadOnly="True"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            Content="{Binding ShowHideTokenLabel}"
                            Click="ShowHideToken_Click"
                            Margin="5,0,0,0"
                            Padding="8,3"/>
                    <Button Grid.Column="3"
                            Content="{DynamicResource String_Settings_Mcp_CopyToken}"
                            Command="{Binding CopyTokenCommand}"
                            Margin="5,0,0,0"
                            Padding="8,3"/>
                    <Button Grid.Column="4"
                            Content="{DynamicResource String_Settings_Mcp_RegenerateToken}"
                            Command="{Binding RegenerateTokenCommand}"
                            Margin="5,0,0,0"
                            Padding="8,3"/>
                </Grid>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
